# Copy to .env and fill in real values. Never commit .env.
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_english_interview?schema=public

# DashScope / Qwen-compatible provider credentials and options.
# Required at API startup; the server exits if DASHSCOPE_API_KEY is missing.
DASHSCOPE_API_KEY=your_api_key_here
LLM_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen3.8-flash
LLM_TIMEOUT_MS=30000
# Optional: override the model used only by POST /resume/parse.
# When unset, the resume parser falls back to LLM_MODEL_ID.
# LLM_RESUME_MODEL_ID=qwen3.8-flash
# Optional: override the model used only by POST /conversations/:id/voice-turn.
# When unset, voice transcription uses qwen-audio-3.0-asr-flash.
# ASR_MODEL_ID=qwen-audio-3.0-asr-flash
# Optional: override the Token Plan base URL for the native ASR endpoint
# ({base}/api/v1/services/aigc/multimodal-generation/generation).
# When unset, https://token-plan.ap-southeast-1.maas.aliyuncs.com is used.
# ASR_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com
# Voice-turn speech synthesis (Token Plan TTS REST, server-side only).
# The API returns an audio URL which the backend downloads; Android only
# ever receives raw PCM bytes and never sees the provider or the URL.
# TTS_MODEL_ID=qwen-audio-3.0-tts-plus
# TTS_VOICE_ID=longanhuan_v3.6
# TTS_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com
# TTS_TIMEOUT_MS=60000
# Optional: resume upload limits (defaults: 5242880 bytes / 100000 chars).
# RESUME_MAX_BYTES=5242880
# RESUME_MAX_TEXT_CHARS=100000

# Optional API listener address (defaults: 0.0.0.0 and 3001).
# HOST=
# PORT=
